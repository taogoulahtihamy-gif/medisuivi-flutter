# ENVIRONNEMENT DE DEVELOPPEMENT UNIQUEMENT. Aucun dossier patient réel.
APP_ENV=development
APP_DATABASE_URL=postgresql+psycopg://medisuivi:change-me@localhost:5437/medisuivi
# Obligatoirement aléatoire : python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# False par défaut : activer uniquement pour les tests de développement locaux
APP_ALLOW_DEVELOPMENT_REGISTRATION=false
