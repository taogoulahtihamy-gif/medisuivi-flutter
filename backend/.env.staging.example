# Copy to .env.staging (DO NOT COMMIT). No real patient information.
# Point DNS A record to the LWS VPS. Example below is NOT a real hostname.
STAGING_API_DOMAIN=staging-api.example.org
# Use two independent secrets. For password, URL-safe characters only.
POSTGRES_PASSWORD=REPLACE_WITH_URLSAFE_RANDOM_PASSWORD
APP_JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
